# Copie este arquivo para ".env" e preencha com os seus dados.
PORT=3000

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=test
DB_NAME=drip_store
DB_NAME_TEST=drip_store_test

# Segurança do login (JWT): use um texto longo e secreto
JWT_SECRET=troque-este-segredo-por-um-texto-longo
JWT_EXPIRES_IN=1d
